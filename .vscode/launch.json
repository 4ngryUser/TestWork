{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch OrangeHRM API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/OrangeHRM.API/bin/Debug/net8.0/OrangeHRM.API.dll",
            "args": [],
            "cwd": "${workspaceFolder}/OrangeHRM.API",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "Attach to OrangeHRM API",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
