{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "OrangeHRM": {
    "BaseUrl": "https://opensource-demo.orangehrmlive.com",
    "Username": "Admin",
    "Password": "admin123"
  },

  "WebDriver": {
    "Headless": false,
    "ImplicitWaitSeconds": 10,
    "PageLoadTimeoutSeconds": 30,
    "CommandTimeoutSeconds": 60
  },

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=orangehrm.db"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/orangehrm-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
